{
  "entities": {
    "Guest": {
      "title": "Guest",
      "description": "Wedding guest preset and attendee in the honored guest list",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier of the guest", "maxLength": 128 },
        "name": { "type": "string", "description": "Full name / title of the honored guest in Khmer or English", "maxLength": 256 },
        "category": { "type": "string", "description": "Guest category (family, vip, friends, colleagues, general)", "maxLength": 50 },
        "categoryLabelKh": { "type": "string", "description": "Khmer category label", "maxLength": 100 },
        "categoryLabelEn": { "type": "string", "description": "English category label", "maxLength": 100 },
        "note": { "type": "string", "description": "Optional note or table assignment", "maxLength": 500 },
        "ownerId": { "type": "string", "description": "Owner user scope ID for per-user guest list isolation", "maxLength": 128 },
        "eventId": { "type": "string", "description": "Associated invitation event ID for per-invitation isolation", "maxLength": 128 },
        "eventType": { "type": "string", "description": "Invitation category (wedding, engagement, housewarming, birthday, anniversary)", "maxLength": 50 },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update", "maxLength": 64 }
      },
      "required": ["name", "category"]
    },
    "Wish": {
      "title": "Wish",
      "description": "Blessing and wish message submitted in the digital guestbook",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique wish identifier", "maxLength": 128 },
        "eventId": { "type": "string", "description": "Target invitation event ID", "maxLength": 128 },
        "ownerId": { "type": "string", "description": "Owner user scope ID of the target invitation", "maxLength": 128 },
        "name": { "type": "string", "description": "Guest sender name", "maxLength": 200 },
        "relationship": { "type": "string", "description": "Relationship to bride/groom", "maxLength": 100 },
        "message": { "type": "string", "description": "Wish blessing message content", "maxLength": 2000 },
        "likes": { "type": "number", "description": "Number of heart likes" },
        "createdAt": { "type": "string", "description": "ISO timestamp string", "maxLength": 64 }
      },
      "required": ["name", "message"]
    },
    "RSVP": {
      "title": "RSVP",
      "description": "Guest RSVP confirmation response",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique RSVP identifier", "maxLength": 128 },
        "eventId": { "type": "string", "description": "Target invitation event ID", "maxLength": 128 },
        "ownerId": { "type": "string", "description": "Owner user scope ID of the target invitation", "maxLength": 128 },
        "name": { "type": "string", "description": "Guest name", "maxLength": 200 },
        "attending": { "type": "string", "description": "Whether attending yes or no", "maxLength": 10 },
        "guestCount": { "type": "number", "description": "Number of attendees" },
        "phone": { "type": "string", "description": "Contact phone number", "maxLength": 50 },
        "note": { "type": "string", "description": "Dietary or congratulatory note", "maxLength": 500 },
        "timestamp": { "type": "string", "description": "Timestamp string", "maxLength": 64 }
      },
      "required": ["name", "attending"]
    },
    "WeddingEvent": {
      "title": "WeddingEvent",
      "description": "Configured wedding event data including couple info, schedule, venue, KHQR and photo gallery",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique event ID", "maxLength": 128 },
        "templateId": { "type": "string", "description": "Base template/preset identifier", "maxLength": 128 },
        "eventType": { "type": "string", "description": "Event category (wedding, engagement, housewarming, birthday, anniversary)", "maxLength": 50 },
        "name": { "type": "string", "description": "Event name / title", "maxLength": 300 },
        "title": { "type": "string", "description": "Alternative event title", "maxLength": 300 },
        "slug": { "type": "string", "description": "Event URL slug", "maxLength": 128 },
        "groom": { "type": "string", "description": "Groom name", "maxLength": 200 },
        "bride": { "type": "string", "description": "Bride name", "maxLength": 200 },
        "groom_name": { "type": "string", "description": "Groom name alias", "maxLength": 200 },
        "bride_name": { "type": "string", "description": "Bride name alias", "maxLength": 200 },
        "ownerId": { "type": "string", "description": "Owner User ID for per-user event isolation", "maxLength": 128 },
        "ownerEmail": { "type": "string", "description": "Owner email address", "maxLength": 256 },
        "image": { "type": "string", "description": "Main Couple Portrait URL or compressed data URI", "maxLength": 500000 },
        "cover_image": { "type": "string", "description": "Cover portrait URL fallback", "maxLength": 500000 },
        "config": { "type": "object", "description": "Full wedding configuration object" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update", "maxLength": 64 }
      },
      "required": ["name"]
    },
    "User": {
      "title": "User",
      "description": "Authenticated user profile for admin and editor management",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth user ID", "maxLength": 128 },
        "email": { "type": "string", "description": "User email address", "maxLength": 256 },
        "displayName": { "type": "string", "description": "User display name", "maxLength": 256 },
        "photoURL": { "type": "string", "description": "User avatar photo URL", "maxLength": 1000 },
        "activeEventId": { "type": "string", "description": "User personal active event ID", "maxLength": 128 },
        "role": { "type": "string", "description": "User access role (admin or editor)", "maxLength": 50 },
        "lastLoginAt": { "type": "string", "description": "ISO timestamp of last login", "maxLength": 64 }
      },
      "required": ["uid", "email"]
    },
    "SystemUser": {
      "title": "SystemUser",
      "description": "Registered system user and administrator account record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique system user identifier", "maxLength": 128 },
        "name": { "type": "string", "description": "Full name of the user", "maxLength": 256 },
        "email": { "type": "string", "description": "Email address of the user", "maxLength": 256 },
        "passcode": { "type": "string", "description": "Passcode credential string", "maxLength": 128 },
        "role": { "type": "string", "description": "Role (admin or user)", "maxLength": 50 },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation", "maxLength": 64 }
      },
      "required": ["name", "email"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Owner dashboard alert and activity log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notification ID", "maxLength": 128 },
        "eventId": { "type": "string", "description": "Associated event ID", "maxLength": 128 },
        "ownerId": { "type": "string", "description": "Owner user scope ID", "maxLength": 128 },
        "title": { "type": "string", "description": "Notification title", "maxLength": 200 },
        "message": { "type": "string", "description": "Notification message body", "maxLength": 2000 },
        "type": { "type": "string", "description": "Notification category or type", "maxLength": 50 },
        "guestName": { "type": "string", "description": "Guest name for RSVP notifications", "maxLength": 200 },
        "attending": { "type": "string", "description": "Attending status yes or no", "maxLength": 10 },
        "read": { "type": "boolean", "description": "Whether notification has been read" },
        "timestamp": { "type": "string", "description": "ISO timestamp string", "maxLength": 64 },
        "createdAt": { "type": "string", "description": "ISO timestamp of notification", "maxLength": 64 }
      },
      "required": ["title", "message"]
    },
    "ShortLink": {
      "title": "ShortLink",
      "description": "Publicly resolvable short link mapping for sharing invitations with Khmer language support",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "Short link code", "maxLength": 128 },
        "url": { "type": "string", "description": "Target invitation URL", "maxLength": 2000 },
        "lang": { "type": "string", "description": "Default language code (e.g. kh or en)", "maxLength": 10 },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation", "maxLength": 64 }
      },
      "required": ["code", "url"]
    },
    "UserDatabase": {
      "title": "UserDatabase",
      "description": "Dedicated per-email personal database registry record isolating each user's events, guests, wishes, RSVPs, and notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Canonical deterministic email database ID (u_<slug>_<hash>)", "maxLength": 128 },
        "email": { "type": "string", "description": "Normalized user email address owning this personal database", "maxLength": 256 },
        "displayName": { "type": "string", "description": "Display name of the database owner", "maxLength": 256 },
        "role": { "type": "string", "description": "User role (owner, admin, editor, user)", "maxLength": 50 },
        "ownerId": { "type": "string", "description": "Canonical ownerId matching dbId", "maxLength": 128 },
        "uid": { "type": "string", "description": "Optional Firebase Auth UID", "maxLength": 128 },
        "status": { "type": "string", "description": "Provisioning status (active)", "maxLength": 32 },
        "createdAt": { "type": "string", "description": "ISO timestamp of personal database creation", "maxLength": 64 },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last database sync", "maxLength": 64 }
      },
      "required": ["id", "ownerId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Authenticated user profiles with authorization roles"
    },
    "/system_users/{userId}": {
      "schema": { "$ref": "#/entities/SystemUser" },
      "description": "System user and administrator account records"
    },
    "/guests/{guestId}": {
      "schema": { "$ref": "#/entities/Guest" },
      "description": "Wedding guest list presets and attendees"
    },
    "/wishes/{wishId}": {
      "schema": { "$ref": "#/entities/Wish" },
      "description": "Public wedding blessings and guestbook messages"
    },
    "/rsvps/{rsvpId}": {
      "schema": { "$ref": "#/entities/RSVP" },
      "description": "Guest RSVP responses"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/WeddingEvent" },
      "description": "Wedding event settings, schedules, gallery and invitation details"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Owner dashboard alerts and activity logs"
    },
    "/short_links/{code}": {
      "schema": { "$ref": "#/entities/ShortLink" },
      "description": "Short link mappings for Vercel and social sharing"
    },
    "/user_databases/{dbId}": {
      "schema": { "$ref": "#/entities/UserDatabase" },
      "description": "Per-email personal database root documents"
    },
    "/user_databases/{dbId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/WeddingEvent" },
      "description": "Personal database wedding/event invitations owned by dbId"
    },
    "/user_databases/{dbId}/events/{eventId}/guests/{guestId}": {
      "schema": { "$ref": "#/entities/Guest" },
      "description": "Per-user and per-invitation isolated guest list owned by dbId and scoped to eventId"
    },
    "/user_databases/{dbId}/guests/{guestId}": {
      "schema": { "$ref": "#/entities/Guest" },
      "description": "Personal database guest presets and attendees owned by dbId"
    },
    "/user_databases/{dbId}/wishes/{wishId}": {
      "schema": { "$ref": "#/entities/Wish" },
      "description": "Personal database guestbook wishes and blessings for dbId"
    },
    "/user_databases/{dbId}/rsvps/{rsvpId}": {
      "schema": { "$ref": "#/entities/RSVP" },
      "description": "Personal database RSVP confirmations for dbId"
    },
    "/user_databases/{dbId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Personal database owner alerts and RSVP notifications for dbId"
    }
  }
}
